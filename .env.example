# ============================================================
# BusinessPro Suite — Required Environment Variables
# Copy this file to .env and fill in real values before running
# ============================================================

# MongoDB Connection
# Use a strong, randomly generated password — never use trivial/guessable ones
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_STRONG_PASSWORD@cluster0.xxxxx.mongodb.net/your_db?retryWrites=true&w=majority&appName=Cluster0

# JWT Secrets (REQUIRED — app will NOT start without these)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Security Settings
ROTATE_REFRESH_TOKEN=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
MAX_ACTIVE_SESSIONS=10

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# CORS Configuration (comma-separated origins, ignored in same-origin Nuxt4 SSR)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# External API Keys (RapidAPI for GST verification / Auto-fill)
RAPIDAPI_KEY=

# PostgreSQL Database Configuration (NeonDB / Postgres for Accounting, Documents & Labor)
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ============================================================
# Backblaze B2 Cloud Storage Configuration (Documents Module)
# Required to upload documents and prevent { "code": "unauthorized", "status": 401 } on private buckets
# ============================================================
# Key ID / Master Key ID from Backblaze B2 Console -> App Keys
B2_APPLICATION_KEY_ID=
# Application Key Secret
B2_APPLICATION_KEY=
# Bucket ID (from Backblaze B2 Console -> Buckets)
B2_BUCKET_ID=
# Bucket Name (e.g. businesspro-documents)
B2_BUCKET_NAME=
# Folder prefix inside bucket (default: documents)
B2_BUCKET_PREFIX=documents

# ============================================================
# Google Firebase Firestore Configuration (Work vs Payment Tracker)
# Single-line Base64 encoded Google Service Account JSON
# Generated from work-vs-payment-firebase-adminsdk-fbsvc-097f413a66.json
# ============================================================
FIREBASE_SERVICE_ACCOUNT_BASE64=



