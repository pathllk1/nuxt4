# ============================================================
# BusinessPro Suite — Required Environment Variables
# Copy this file to .env and fill in real values before running
# ============================================================

# MongoDB Connection
# Use a strong, randomly generated password — never use trivial/guessable ones
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_STRONG_PASSWORD@cluster0.xxxxx.mongodb.net/your_db?retryWrites=true&w=majority&appName=Cluster0

# JWT Secrets (REQUIRED — app will NOT start without these)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Security Settings
ROTATE_REFRESH_TOKEN=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# CORS Configuration (comma-separated origins, ignored in same-origin Nuxt4 SSR)
CORS_ORIGINS=http://localhost:3000

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# External API Keys
RAPIDAPI_KEY=

# PostgreSQL Database Configuration
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require
